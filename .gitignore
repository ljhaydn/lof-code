# Ignore everything by default in plugins and themes
plugins/*
themes/*

# But keep our custom plugins
!plugins/lights-on-falcon-extras/
!plugins/remote-falcon-viewer/

# And keep our integrations theme
!themes/integrations/

# Ignore uploads & other noisy dirs
uploads/
cache/
upgrade/
updraft/
integrate-google-drive-cache/
# Optional safety net:
*.zip
*.gz
.DS_Store

# Season 2025/2026 custom plugins (added Jul 2026 audit)
# lof-viewer2, lof-audio-sync, lof-media-intake are separate repos:
#   github.com/ljhaydn/{lof-viewer2,lof-audio-sync,lof-media-intake}
plugins/lof-viewer2/
plugins/lof-audio-sync/
plugins/lof-media-intake/
!plugins/lof-weather-footer/
!plugins/lof-mongo-debug.php
